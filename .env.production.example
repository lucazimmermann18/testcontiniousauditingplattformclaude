# ── Continuum Audit — Production Environment ─────────────────────────
# Copy this file to .env on your server and fill in the values.
# Generate secrets with: openssl rand -base64 32

# ── Database ─────────────────────────────────────────────────────────
# SQLite via libSQL — stored in Docker volume at /data/app.db
DATABASE_URL="file:/data/app.db"

# ── Auth.js ──────────────────────────────────────────────────────────
# REQUIRED — generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_ME_openssl_rand_-base64_32"

# Your public domain (with https://)
NEXTAUTH_URL="https://YOUR_DOMAIN"

# ── Encryption (API keys stored encrypted at rest) ───────────────────
# REQUIRED — generate with: openssl rand -base64 32
# ⚠ If you change this, all stored API keys become unreadable
ENCRYPTION_SECRET="REPLACE_ME_openssl_rand_-base64_32"

# ── Cron-Job (Agent Scheduler) ───────────────────────────────────────
# REQUIRED for scheduled agents — generate with: openssl rand -base64 32
# Set as GitHub Actions secret CRON_SECRET (and APP_URL = your domain)
# Vercel: add to project environment variables, cron is configured in vercel.json
CRON_SECRET="REPLACE_ME_openssl_rand_-base64_32"

# ── Node ─────────────────────────────────────────────────────────────
NODE_ENV="production"
